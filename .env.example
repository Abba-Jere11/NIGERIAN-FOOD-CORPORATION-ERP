# ---------------------------------------------------------------------------
# NFC Mini ERP - environment template.
# Copy to `.env` at the repository root and fill in the real values.
# `.env` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database owner (local PostgreSQL service on port 5432) -----------------
# The superuser used for migrations, seeds and test fixtures. As table owner it
# bypasses Row-Level Security, which is why the application never uses it.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=CHANGEME

# Application databases. `pnpm db:bootstrap` creates both.
PGDATABASE=nfc_erp_dev
PGDATABASE_TEST=nfc_erp_test

# --- Application database role ---------------------------------------------
# The least-privileged role the API connects as. It is not the table owner and
# is created NOBYPASSRLS, so Row-Level Security genuinely applies to it (R5).
# It holds no DELETE privilege on business tables, so rule R3 is enforced by
# privilege as well as by trigger. `pnpm db:bootstrap` creates it.
APP_DB_USER=nfc_app
APP_DB_PASSWORD=CHANGEME

# Optional full-URL overrides. Left blank, URLs are built from the parts above.
DATABASE_URL=
DATABASE_URL_TEST=
DATABASE_URL_OWNER=
DATABASE_URL_TEST_OWNER=

# --- API -------------------------------------------------------------------
API_PORT=4000
API_HOST=127.0.0.1
LOG_LEVEL=info
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Dev-only actor context (M1 bridge, removed in M2) ---------------------
# M1 has no users, authentication or roles - those arrive in M2. Until then the
# API resolves the acting identity from this default, or from an `x-dev-actor`
# header naming one of the registered demo actors (md, ed.operations,
# ed.finance, gm.yfz, gm.yfw, gm.dma, gm.nom, fh.yfz, fh.yfw, fh.dma, fh.nom).
# Refused outright when NODE_ENV=production.
DEV_ACTOR_ENABLED=true
DEV_ACTOR_DEFAULT=md

# --- Web -------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
